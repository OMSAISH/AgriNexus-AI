# AgriNexus AI — Environment Variables
PROJECT_NAME="AgriNexus AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL 18 on port 5433)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5433
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="agrinexus_db"
DATABASE_URL="postgresql+psycopg2://postgres@localhost:5433/agrinexus_db"

# Security & Authentication
SECRET_KEY="agrinexus_super_secret_jwt_key_change_in_production_phase_1"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
